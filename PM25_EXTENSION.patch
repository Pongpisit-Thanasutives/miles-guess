+    "fig.tight_layout()\n",
+    "fig.savefig(out / \"test_station_sources.png\", dpi=150)\n",
+    "plt.show()"
+   ],
+   "execution_count": null,
+   "outputs": []
+  },
+  {
+   "cell_type": "code",
+   "id": "8b3444b1cddb",
+   "metadata": {},
+   "source": [
+    "# Keep the per-row vector as valid JSON in the CSV, alongside numeric source columns.\n",
+    "export = points.copy()\n",

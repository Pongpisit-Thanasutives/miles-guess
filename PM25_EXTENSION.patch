+   ],
+   "execution_count": null,
+   "outputs": []
+  },
+  {
+   "cell_type": "markdown",
+   "id": "057ba805800f",
+   "metadata": {},
+   "source": [
+    "### 4. Train and select the epoch on validation stations\n",
+    "\n",

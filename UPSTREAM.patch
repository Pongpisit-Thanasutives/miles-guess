+    "\n",
+    "def point_metrics(y, mean):\n",
+    "    residual = np.asarray(y) - np.asarray(mean)\n",
+    "    denominator = np.sum((y - np.mean(y, axis=0))**2, axis=0)\n",
+    "    r2 = np.full_like(denominator, np.nan, dtype=float)\n",
+    "    np.divide(np.sum(residual**2, axis=0), denominator, out=r2, where=denominator > 0)\n",
+    "    return pd.DataFrame({\"mae\": np.mean(abs(residual), axis=0),\n",
+    "                         \"rmse\": np.sqrt(np.mean(residual**2, axis=0)), \"r2\": 1-r2},\n",
+    "                        index=output_cols)\n",
+    "\n",
+    "def evaluate_gaussian_mixture(y, member_means, member_variances):\n",
+    "    # Equal-weight Gaussian mixture; intervals and NLL use the mixture itself.\n",
+    "    means = np.asarray(member_means, dtype=float)\n",
+    "    variances = np.asarray(member_variances, dtype=float)\n",
+    "    assert means.ndim == 3 and means.shape == variances.shape\n",
+    "    assert np.all(np.isfinite(means)) and np.all(np.isfinite(variances))\n",
+    "    assert np.all(variances > 0)\n",
+    "    sigma = np.sqrt(variances)\n",
+    "    mean = means.mean(axis=0)\n",
+    "    aleatoric = variances.mean(axis=0)\n",
+    "    epistemic = means.var(axis=0, ddof=0)\n",
+    "    metrics = point_metrics(y, mean)\n",
+    "    metrics[\"nll\"] = -np.mean(logsumexp(norm.logpdf(y[None], means, sigma), axis=0)\n",
+    "                               - np.log(len(means)), axis=0)\n",
+    "    def quantile(q):\n",
+    "        component_quantiles = means + norm.ppf(q)*sigma\n",
+    "        lower, upper = component_quantiles.min(axis=0), component_quantiles.max(axis=0)\n",
+    "        for _ in range(50):\n",
+    "            midpoint = (lower+upper)/2\n",
+    "            below = norm.cdf(midpoint[None], means, sigma).mean(axis=0) < q\n",
+    "            lower = np.where(below, midpoint, lower)\n",
+    "            upper = np.where(below, upper, midpoint)\n",
+    "        return (lower+upper)/2\n",
+    "    intervals, records = {}, []\n",
+    "    for level in (.5, .8, .9, .95):\n",
+    "        lower, upper = quantile((1-level)/2), quantile((1+level)/2)\n",
+    "        intervals[level] = (lower, upper)\n",
+    "        for target in range(y.shape[1]):\n",
+    "            records.append({\"target\": target, \"nominal\": level,\n",
+    "                \"observed\": np.mean((y[:, target] >= lower[:, target]) & (y[:, target] <= upper[:, target])),\n",
+    "                \"mean_width\": np.mean(upper[:, target]-lower[:, target])})\n",

+    "ensemble_splitter = GroupShuffleSplit(n_splits=n_splits,random_state=flat_seed,train_size=.885)\n",
+    "for split_id,(train_idx,valid_idx) in enumerate(ensemble_splitter.split(train_pool,groups=train_pool[\"day\"])):\n",
+    "    member_train, member_valid = train_pool.iloc[train_idx],train_pool.iloc[valid_idx]\n",
+    "    xs,ys = RobustScaler(),MinMaxScaler((0,1))\n",
+    "    member_x_train = xs.fit_transform(member_train[input_cols])\n",
+    "    member_x_valid = xs.transform(member_valid[input_cols])\n",
+    "    member_y_train = ys.fit_transform(member_train[output_cols])\n",
+    "    member_y_valid = ys.transform(member_valid[output_cols])\n",
+    "    member_configuration = deepcopy(gaussian_conf)\n",
+    "    member_configuration[\"model\"][\"verbose\"] = 0\n",
+    "    member = GaussianRegressorDNN(**member_configuration[\"model\"])\n",
+    "    member.build_neural_network(len(input_cols),len(output_cols))\n",

+    "x_test = as_tensor(x_scaler.transform(X[test_idx]))\n",
+    "with torch.no_grad():\n",
+    "    probabilities, evidence_uncertainty, aleatoric, epistemic = (\n",
+    "        value.cpu().numpy() for value in model.predict(x_test)\n",
+    "    )\n",
+    "test = evaluate_classifier(y[test_idx], probabilities, n_bins=10)\n",
+    "predicted = probabilities.argmax(axis=1)\n",
+    "correct = predicted == y[test_idx]\n",
+    "assert np.allclose(probabilities.sum(axis=1), 1.0)\n",
+    "assert np.allclose(aleatoric + epistemic, probabilities * (1.0 - probabilities), atol=1e-7)\n",
+    "assert np.isfinite(list(test[\"metrics\"].values())).all()\n",
+    "display(pd.DataFrame([test[\"metrics\"]], index=[\"untouched test\"]).round(4))\n",
+    "display(test[\"reliability\"].round(4))\n",
+    "display(pd.DataFrame({\"mean aleatoric variance\": aleatoric.mean(axis=0),\n",
+    "                      \"mean epistemic variance\": epistemic.mean(axis=0)}, index=class_names).round(4))\n"
+   ]
+  },
+  {
+   "cell_type": "markdown",
+   "id": "classifier-08",
+   "metadata": {},
+   "source": [
+    "## 4. Compare predictions and inspect calibration\n",
+    "\n",
+    "The confusion matrix uses true classes as rows and predicted classes as columns.\n",
+    "Reliability compares average top-class confidence with the fraction correct in\n",
+    "each nonempty bin. Marker sizes show bin counts. The gray diagonal is ideal calibration.\n",
+    "These diagnostics report the frozen model as it is; no test-based recalibration is applied.\n"
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": 5,
+   "id": "classifier-09",
+   "metadata": {},
+   "outputs": [
+    {
+     "data": {
+      "image/png": "",
+      "text/plain": [
+       "<Figure size 1210x462 with 2 Axes>"
+      ]

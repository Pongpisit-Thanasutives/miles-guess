+    "axes[1].set(xlim=(0.1, 1), ylim=(0, max(0.3, retained_error[int(0.1 * len(rank)):].max() * 1.1)),\n",
+    "            xlabel=\"Fraction retained (least uncertain first)\", ylabel=\"Error rate among retained cases\",\n",
+    "            title=\"Uncertainty ranking diagnostic\")\n",
+    "axes[1].legend(); fig.tight_layout(); plt.show()\n"

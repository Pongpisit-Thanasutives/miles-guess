+    assert mean.shape == (3, 2)
+    np.testing.assert_allclose(mean.sum(-1), 1, atol=1e-7)
+    np.testing.assert_allclose(ale + epi, mean * (1 - mean), atol=1e-7)
+    assert np.isfinite(entropy).all() and np.isfinite(mi).all()
+

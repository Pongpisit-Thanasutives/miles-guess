+    "splits = list(gsp.split(train_data, groups=train_data[\"year\"]))\n",
+    "train_index, valid_index = splits[data_seed]\n",
+    "train_data, valid_data = train_data.iloc[train_index].copy(), train_data.iloc[valid_index].copy()"

+    "    model.train()\n",
+    "    permutation = torch.randperm(len(X_train), generator=generator)\n",
+    "    training_sum = 0.0\n",
+    "    for indices in permutation.split(BATCH_SIZE):\n",
+    "        optimizer.zero_grad(set_to_none=True)\n",
+    "        output = model(X_train[indices])\n",
+    "        loss = criterion(*output, Y_train[indices]) if TASK == \"regression\" else criterion(output, Y_train[indices], epoch)\n",
+    "        if not torch.isfinite(loss): raise RuntimeError(\"Nonfinite training loss; inspect data scaling and learning rate\")\n",
+    "        loss.backward()\n",
+    "        optimizer.step()\n",
+    "        training_sum += loss.item()*len(indices)\n",
+    "    model.eval()\n",
+    "    with torch.no_grad():\n",
+    "        if TASK == \"regression\":\n",
+    "            mu, nu, alpha, beta = model(X_val)\n",
+    "            pred = torch.distributions.StudentT(2*alpha, mu, torch.sqrt(beta*(1+nu)/(nu*alpha)))\n",

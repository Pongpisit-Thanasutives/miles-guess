+def class_frames():
+    return {
+        "train": pd.DataFrame({"x": [0., 2.], "a": [1, 0], "b": [0, 0], "c": [0, 1]}, index=[10, 20]),
+        "val": pd.DataFrame({"x": [100.], "a": [0], "b": [1], "c": [0]}, index=[99]),
+        "test": pd.DataFrame(columns=["x", "a", "b", "c"], dtype=float),
+    }

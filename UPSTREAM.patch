+    "def parse_plot_times(frame, column):\n",
+    "    \"\"\"Read plotting coordinates without altering row order, features, or splitting.\"\"\"\n",
+    "    if column is None:\n",
+    "        return None\n",
+    "    if column not in frame:\n",
+    "        raise ValueError(f\"Plot time column {column!r} is absent from the CSV\")\n",
+    "    values = frame[column]\n",
+    "    if pd.api.types.is_numeric_dtype(values):\n",
+    "        times = pd.to_numeric(values, errors=\"coerce\")\n",
+    "        invalid = ~np.isfinite(times.to_numpy(dtype=float))\n",
+    "    else:\n",
+    "        parsed = [pd.to_datetime(value, errors=\"coerce\", format=\"mixed\") for value in values]\n",
+    "        aware = {value.tzinfo is not None for value in parsed if not pd.isna(value)}\n",
+    "        if len(aware) > 1:\n",
+    "            raise ValueError(f\"Plot time column {column!r} mixes timezone-naive and timezone-aware values; normalize them explicitly first\")\n",
+    "        # Never invent a timezone for source timestamps whose timezone is unstated.\n",
+    "        times = pd.Series(pd.to_datetime(parsed, utc=aware == {True}), index=values.index, name=values.name)\n",
+    "        invalid = times.isna().to_numpy()\n",
+    "    if invalid.any():\n",
+    "        rows = np.flatnonzero(invalid)[:5].tolist()\n",
+    "        raise ValueError(f\"Plot time column {column!r} contains missing or invalid times at row positions {rows}\")\n",
+    "    return times\n",
+    "\n",
+    "\n",
+    "def prediction_display(predicted, times=None, window=None):\n",
+    "    \"\"\"Return positions into predictions and meaningful x coordinates for display.\"\"\"\n",
+    "    if times is None:\n",
+    "        order = np.argsort(predicted, kind=\"stable\")\n",
+    "        return order, np.asarray(predicted)[order]\n",
+    "    times = times.reset_index(drop=True)\n",
+    "    order = np.argsort(times.to_numpy(), kind=\"stable\")\n",
+    "    if window is not None:\n",
+    "        if pd.api.types.is_numeric_dtype(times):\n",
+    "            if isinstance(window, bool) or not isinstance(window, (int, float)) or not np.isfinite(window) or window <= 0:\n",
+    "                raise ValueError(\"For numeric times, PLOT_TIME_WINDOW must be a positive number in the source time units\")\n",
+    "            duration = window\n",
+    "        else:\n",
+    "            try:\n",
+    "                duration = pd.Timedelta(window)\n",
+    "            except (TypeError, ValueError) as exc:\n",
+    "                raise ValueError(\"For date/time values, PLOT_TIME_WINDOW must be a duration such as '7D'\") from exc\n",
+    "            if pd.isna(duration) or duration <= pd.Timedelta(0):\n",
+    "                raise ValueError(\"PLOT_TIME_WINDOW must be a positive duration\")\n",
+    "        order = order[(times.iloc[order] < times.iloc[order[0]] + duration).to_numpy()]\n",
+    "    return order, times.iloc[order]\n",
+    "\n",

+    "def batched_classifier_predictions(trained_model, features, *, evidential, batch_size=1024):\n",
+    "    trained_model.eval()\n",
+    "    collected = []\n",
+    "    with torch.inference_mode():\n",
+    "        for start in range(0, len(features), batch_size):\n",
+    "            inputs = torch.as_tensor(features[start:start + batch_size], dtype=torch.float32, device=device)\n",
+    "            logits = trained_model(inputs)\n",
+    "            if evidential:\n",
+    "                collected.append(tuple(value.cpu().numpy() for value in trained_model.calc_uncertainty(logits)))\n",
+    "            else:\n",
+    "                collected.append(torch.softmax(logits, dim=1).cpu().numpy())\n",
+    "    if evidential:\n",
+    "        return tuple(np.concatenate([chunk[index] for chunk in collected]) for index in range(4))\n",
+    "    return np.concatenate(collected)\n",
+    "\n",
+    "test_features = scaled_data[\"test_x\"].to_numpy()\n",
+    "test_labels = np.argmax(scaled_data[\"test_y\"], axis=1).astype(np.int64)\n",
+    "point_probabilities = batched_classifier_predictions(mlp, test_features, evidential=False)\n",
+    "evidential_probabilities, vacuity, aleatoric, epistemic = batched_classifier_predictions(\n",
+    "    ev_mlp, test_features, evidential=True)\n",
+    "point_test = evaluate_classifier(test_labels, point_probabilities, n_bins=10)\n",
+    "evidential_test = evaluate_classifier(test_labels, evidential_probabilities, n_bins=10)\n",
+    "test_metrics = pd.DataFrame([point_test[\"metrics\"], evidential_test[\"metrics\"]],\n",
+    "                            index=[\"Standard classifier\", \"Evidential classifier\"])\n",
+    "display(test_metrics)\n",
+    "display(pd.DataFrame({\"class\": output_features, \"test_count\": np.bincount(test_labels, minlength=num_classes)}))\n",
+    "assert np.allclose(aleatoric + epistemic, evidential_probabilities * (1 - evidential_probabilities),\n",
+    "                   rtol=1e-5, atol=1e-7)\n"

+    "    for xb, yb in loader:\n",
+    "        optimizer.zero_grad(set_to_none=True)\n",
+    "        target = torch.nn.functional.one_hot(yb, num_classes=num_classes).float()\n",
+    "        loss = edl_digamma_loss(model(xb), target, epoch_num=epoch,\n",

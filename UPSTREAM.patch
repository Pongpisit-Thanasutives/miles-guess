+    "def split_rows(frame, task, strategy, labels, test_fraction, validation_fraction,\n",
+    "               seed, group_column=None, time_column=None):\n",
+    "    if not (0 < test_fraction < 1 and 0 < validation_fraction < 1\n",
+    "            and test_fraction + validation_fraction < 1):\n",
+    "        raise ValueError(\"Choose positive test/validation fractions with sum below one\")\n",
+    "    rows = np.arange(len(frame))\n",
+    "    if strategy == \"random\":\n",
+    "        stratify = labels if task == \"classification\" else None\n",
+    "        train_val, test = train_test_split(rows, test_size=test_fraction,\n",
+    "                                           random_state=seed, stratify=stratify)\n",
+    "        stratify_tv = labels[train_val] if task == \"classification\" else None\n",
+    "        train, validation = train_test_split(train_val,\n",
+    "            test_size=validation_fraction/(1-test_fraction),\n",
+    "            random_state=seed+1, stratify=stratify_tv)\n",
+    "    elif strategy == \"group\":\n",
+    "        if group_column is None or frame[group_column].isna().any():\n",
+    "            raise ValueError(\"Provide a complete GROUP_COLUMN\")\n",
+    "        groups = frame[group_column].to_numpy()\n",
+    "        train_val, test = next(GroupShuffleSplit(n_splits=1, test_size=test_fraction,\n",
+    "            random_state=seed).split(rows, groups=groups))\n",
+    "        tr, va = next(GroupShuffleSplit(n_splits=1,\n",
+    "            test_size=validation_fraction/(1-test_fraction), random_state=seed+1)\n",
+    "            .split(train_val, groups=groups[train_val]))\n",
+    "        train, validation = train_val[tr], train_val[va]\n",
+    "        assert not (set(groups[train]) & set(groups[test]))\n",
+    "        assert not (set(groups[train]) & set(groups[validation]))\n",
+    "        assert not (set(groups[validation]) & set(groups[test]))\n",
+    "    elif strategy == \"time\":\n",
+    "        if time_column is None or frame[time_column].isna().any():\n",
+    "            raise ValueError(\"Provide a complete TIME_COLUMN\")\n",
+    "        times = frame[time_column]\n",
+    "        if not pd.api.types.is_numeric_dtype(times):\n",
+    "            times = pd.to_datetime(times, errors=\"raise\", utc=True)\n",
+    "        # Whole equal-time blocks stay in one subset; no same-time leakage.\n",
+    "        unique_times = np.sort(times.unique())\n",
+    "        if len(unique_times) < 5: raise ValueError(\"Need at least five distinct times\")\n",
+    "        cut1 = max(1, int(len(unique_times)*(1-test_fraction-validation_fraction)))\n",
+    "        cut2 = max(cut1+1, int(len(unique_times)*(1-test_fraction)))\n",
+    "        cut2 = min(cut2, len(unique_times)-1)\n",
+    "        train = rows[times.isin(unique_times[:cut1])]\n",
+    "        validation = rows[times.isin(unique_times[cut1:cut2])]\n",
+    "        test = rows[times.isin(unique_times[cut2:])]\n",
+    "    else:\n",
+    "        raise ValueError(\"Unknown split strategy\")\n",
+    "    assert set(train).isdisjoint(validation) and set(train).isdisjoint(test)\n",
+    "    assert set(validation).isdisjoint(test)\n",
+    "    assert len(train)+len(validation)+len(test) == len(frame)\n",
+    "    return train, validation, test\n",
+    "\n",
+    "train_idx, val_idx, test_idx = split_rows(frame, TASK, SPLIT_STRATEGY, y_all,\n",
+    "    TEST_FRACTION, VALIDATION_FRACTION, SEED, GROUP_COLUMN, TIME_COLUMN)\n",
+    "split_labels = np.empty(len(frame), dtype=object)\n",
+    "split_labels[train_idx], split_labels[val_idx], split_labels[test_idx] = \"train\", \"validation\", \"test\"\n",
+    "pd.DataFrame({\"row_position\": np.arange(len(frame)), \"split\": split_labels}).to_csv(\n",
+    "    OUTPUT_DIR/\"split_assignments.csv\", index=False)\n",
+    "display(pd.Series(split_labels).value_counts().rename(\"rows\").to_frame())"

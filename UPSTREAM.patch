+    "        total_evidence += mean_evidence.item()\n",
+    "        total_evidence_succ += mean_evidence_succ.item()\n",
+    "        total_evidence_fail += mean_evidence_fail.item()\n",
+    "        total_uncertainty += torch.mean(u).item()\n",

+    "# Batched inference keeps evaluation memory bounded without changing training settings.\n",
+    "def batched_forward(trained_model, features, batch_size=1024):\n",
+    "    trained_model.eval()\n",
+    "    chunks = []\n",
+    "    with torch.inference_mode():\n",
+    "        for start in range(0, len(features), batch_size):\n",
+    "            inputs = torch.as_tensor(features[start:start + batch_size], dtype=torch.float32, device=device)\n",
+    "            output = trained_model(inputs)\n",
+    "            chunks.append(tuple(value.cpu().numpy() for value in output) if isinstance(output, tuple)\n",
+    "                          else output.cpu().numpy())\n",
+    "    if isinstance(chunks[0], tuple):\n",
+    "        return tuple(np.concatenate([chunk[index] for chunk in chunks]) for index in range(4))\n",
+    "    return np.concatenate(chunks)\n",
